{
  "name": "innnova-assistant-backend",
  "version": "1.0.0",
  "description": "Backend for autonomous personal assistant agent",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "npm run build:frontend && node src/server.js",
